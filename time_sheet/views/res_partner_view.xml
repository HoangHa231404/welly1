<odoo>
    <record id="view_partner_form_inherit_multi_photo_and_camera" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.multi.photo.and.camera</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Thêm header mới nếu không có -->
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="%(action_camera_wizard)d"
                            type="action"
                            string="Chụp ảnh"
                            class="btn-primary"
                            context="{'default_user_id': uid}" />
                </header>
            </xpath>

            <!-- Tab ảnh đăng ký -->
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Ảnh đăng ký">
                    <field name="photo_ids">
                        <tree editable="bottom">
                            <field name="image" widget="image" options="{'size': [300, 250]}"/>
                            <field name="description"/>
                            <field name="capture_time"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
