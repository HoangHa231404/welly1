<odoo>
    <!-- Wizard form -->
    <record id="view_camera_wizard_form" model="ir.ui.view">
        <field name="name">camera.wizard.form</field>
        <field name="model">camera.wizard</field>
        <field name="arch" type="xml">
            <form string="Chụp ảnh người dùng" js_class="camera_wizard_form">
                <group>
                    <div>
                        <video id="wizard_camera_stream"
                               width="640"
                               autoplay="true"
                               style="margin-bottom:10px; border:1px solid #ccc;">
                        </video>
                        <br/>
                        <div class="btn-group" style="margin-top: 10px;">
                            <a href="#" class="btn btn-primary o_camera_btn_start" role="button">Bật Camera</a>
                            <a href="#" class="btn btn-primary o_camera_btn_checkin" role="button">Giờ vào</a>
                            <a href="#" class="btn btn-success o_camera_btn_checkout" role="button">Giờ ra</a>
                            <a href="#" class="btn btn-danger o_camera_btn_stop" role="button">Tắt Camera</a>
                        </div>
                    </div>
                </group>
                
                <footer>
                    <button string="Đóng"
                        special="cancel"
                        class="btn btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action để mở Wizard -->
    <record id="action_camera_wizard" model="ir.actions.act_window">
        <field name="name">Chụp ảnh người dùng</field>
        <field name="res_model">camera.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_camera_wizard_form" />
        <field name="target">new</field>
    </record>

    <!-- Menu chính và menu wizard -->
    <menuitem id="menu_camera_root" name="Camera" sequence="10" />

    <menuitem id="menu_camera_wizard" name="Chụp ảnh" parent="menu_camera_root"
        action="action_camera_wizard" />
</odoo>
